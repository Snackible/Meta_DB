# Meta Ads API — same values as CEO Dashboard
META_TOKEN=
META_AD_ACCOUNT_ID=act_

# Auth.js / NextAuth
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=                        # openssl rand -base64 32

# Google OAuth (for sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed email addresses (comma-separated, no spaces)
ALLOWED_EMAILS=aditi@snackible.com

# Google Sheets — service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=           # looks like: name@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=     # paste the full PEM key, \n for line breaks
GOOGLE_SHEET_ID=                        # the long ID from the sheet URL

# Cron protection
CRON_SECRET=                            # openssl rand -base64 32
